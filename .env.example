# Copy this file to `.env` in the repo root. docker-compose automatically
# loads it to fill in ${VAR} references in docker-compose.yml / .prod.yml.
# Required for production; dev falls back to the defaults baked into
# docker-compose.yml if this file doesn't exist.

POSTGRES_USER=postgres
# docker-compose.yml embeds this directly into DATABASE_URL as a connection
# string (postgresql://user:PASSWORD@db:5432/...), so avoid characters that
# have special meaning in a URL — @ : / # % ? — or they'll break parsing and
# Prisma/pg won't be able to connect. Stick to letters, numbers, and -_.
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=store_db

# Baked into the frontend's static build at build time (docker-compose.prod.yml only)
VITE_API_URL=https://api.yourdomain.com/api
